# ---------------------------------------------------------------------------
# SRM TRP Transport — environment template
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit a filled-in `.env`, and never paste secrets into chat or issues.
# Generate the JWT secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# Runtime mode: development | testing | production
ENVIRONMENT=development
# Debug is only honoured when ENVIRONMENT=development, and never in production.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Supabase PostgreSQL session pooler connection URL. Set privately in .env.
# Include ?sslmode=verify-full and use the database role/password; see the runbook.
# Never commit this URL. The CA certificate must be downloaded from Supabase.
DATABASE_URL=
PGSSLROOTCERT=

# HS256 signing key for access tokens. Must be >= 32 characters in production.
JWT_SECRET=replace-me-with-a-long-random-value
# Access token lifetime in minutes (1-60).
JWT_TTL_MINUTES=15
# Set to true when serving over HTTPS (defaults to true in production).
COOKIE_SECURE=false

# Comma-separated allowlist of explicit origins allowed to call /api/*.
# Wildcards are rejected by the application on purpose.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Set to true ONLY when a reverse proxy (Render, Railway, nginx, Cloud Run with
# Direct VPC) appends X-Forwarded-For/X-Forwarded-Proto in front of gunicorn.
# It makes login throttling and the audit log use the real client address and
# the original scheme. Leave false when the app is reachable directly.
TRUST_PROXY_HEADERS=false

# Comma-separated device API keys accepted by POST /api/events.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEYS=replace-me-with-a-device-api-key

# Login throttling (Flask-Limiter syntax).
LOGIN_RATE_LIMIT=5 per minute;20 per hour
RATELIMIT_ENABLED=true
# Use a shared store (e.g. redis://) when running more than one worker process.
RATELIMIT_STORAGE_URI=memory://

# Business timezone used for "today" boundaries and chart buckets.
APP_TIMEZONE=Asia/Kolkata
# OCR confidence below this value flags a vehicle as "low_ocr_confidence".
OCR_CONFIDENCE_THRESHOLD=0.75
# Hours a bus may stay inside before it is flagged as "long_overstay".
OVERSTAY_HOURS=12

# Optional live camera streams as JSON. Missing cameras are labelled "Demo footage".
# {"gate-1-entry": {"type": "hls", "url": "https://example.edu/stream.m3u8", "label": "Gate 1 Entry"}}
# type must be "hls", "mjpeg" or "rtsp"; credentials must not be embedded in the URL.
# NOTE: raw RTSP cannot be played by a browser — bridge it through MediaMTX or
# FFmpeg to HLS/MJPEG first, then point "url" at the gateway. See docs/CAMERAS.md.
CAMERA_STREAM_URLS=

# ---------------------------------------------------------------------------
# Bus sticker detection (see docs/DETECTION.md)
# ---------------------------------------------------------------------------
# Path to the Ultralytics checkpoint. Defaults to ./best.pt.
VISION_MODEL_PATH=best.pt
# Minimum detection confidence for a sticker box.
VISION_CONFIDENCE=0.35
# OCR engine: auto | rapidocr | tesseract | easyocr | none
# "auto" tries rapidocr, then tesseract, then easyocr, and uses the first that works.
VISION_OCR_ENGINE=auto
# Maximum number of sticker crops that are OCR'd in a single frame.
VISION_MAX_CROPS=8

# ---------------------------------------------------------------------------
# Firebase (optional). See docs/FIREBASE.md and docs/AUTHENTICATION.md.
# The console works fully without these; the SDK is only downloaded when the
# configuration is complete. Web API keys are public identifiers, not secrets.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyCrHtqtEc96pUsbO1O3K_GF2fXqD-CzE2c
FIREBASE_AUTH_DOMAIN=vision-ai-srmtrp.firebaseapp.com
FIREBASE_PROJECT_ID=vision-ai-srmtrp
FIREBASE_STORAGE_BUCKET=vision-ai-srmtrp.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=235811571442
FIREBASE_APP_ID=1:235811571442:web:342e488e0ac2ee75b0f26b
FIREBASE_MEASUREMENT_ID=G-S4HS9TGV4H

# --- Firebase Authentication ---------------------------------------------
# Firebase sign-in (email/password + Google) is switched on automatically
# once FIREBASE_PROJECT_ID and FIREBASE_APP_ID are set. Set
# FIREBASE_AUTH_ENABLED=false to turn it off and use only local accounts.
FIREBASE_AUTH_ENABLED=true
# Which Firebase sign-in providers the portal accepts. Google sign-in is
# additionally restricted by the backend's access list.
FIREBASE_ALLOWED_PROVIDERS=password,google.com
# When true, a verified email/password identity can be auto-provisioned only
# if a trusted Firebase administrator set its transport_portal_approved_email
# custom claim to the same verified email. Self-sign-up alone grants no access.
# Google sign-in never auto-provisions. Set to false to require a pre-seeded
# access-list entry for everybody.
FIREBASE_AUTO_PROVISION=true
# The role given to an auto-provisioned account. Use transport_office
# (least privilege) unless the person is the head of the transport office.
FIREBASE_DEFAULT_ROLE=transport_office
# Keep the local database password login as a break-glass path. Set to false
# once Firebase sign-in is working for everyone.
LEGACY_PASSWORD_LOGIN_ENABLED=true

# ---------------------------------------------------------------------------
# Demo seeding (optional). `python3 -m backend.seed_demo` refuses to run
# unless ALLOW_DEMO_SEED=true and both passwords are set here.
# ---------------------------------------------------------------------------
ALLOW_DEMO_SEED=false
SEED_HEAD_ADMIN_EMAIL=head.admin@example.invalid
SEED_HEAD_ADMIN_PASSWORD=replace-me-with-a-demo-password
SEED_TRANSPORT_EMAIL=transport.office@example.invalid
SEED_TRANSPORT_PASSWORD=replace-me-with-a-demo-password
