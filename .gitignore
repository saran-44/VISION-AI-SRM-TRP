# --- Personal / operational data that must never be committed -------------
# Gate event exports and driver records contain personal data.
*.csv
*.xlsx
*.xls
*.pdf
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.heic
data/
datasets/
media/
videos/
photos/
uploads/

# --- Trained checkpoints -----------------------------------------------------
# The sticker model that ships with the project is tracked as `best.pt`, and the
# number-plate model as `anpr_best.pt`. Everything else a training run produces
# stays on the machine that trained it: optional checkpoints live in `weights/`,
# Ultralytics writes its runs next to the dataset, and manual backups of an old
# checkpoint (`best-v10n-backup.pt`) are never part of the project.
weights/
runs/
*-backup.pt
*.pt.bak

# The official SRM TRP crest and wordmark are branding assets, not captured
# media, and must be tracked.
!frontend/assets/logo-emblem.png
!frontend/assets/logo-wordmark.png
!frontend/assets/favicon.png

# --- Supabase CLI -----------------------------------------------------------
# `supabase init` / `supabase link` write local state (and linked project refs)
# here. This project applies its schema through the Supabase SQL Editor, so the
# CLI directory is never needed in Git.
supabase/.temp/
.supabase/
.branches/

# --- Firebase ---------------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc.local

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
