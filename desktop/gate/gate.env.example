# VISION AI - SRM TRP, gate PC configuration.
#
# VisionAI.exe --setup writes this file to %PROGRAMDATA%\VisionAI\gate.env with
# a fresh JWT_SECRET and the camera you choose. Edit it by hand only for the
# values marked below; everything else the wizard already set correctly.
#
# This file holds a signing secret. Do not commit it, do not email it, do not
# paste it in chat.

# ---------------------------------------------------------------- identity
ENVIRONMENT=gate
PORT=8080
APP_TIMEZONE=Asia/Kolkata
GATE_NAME=Gate 1

# ----------------------------------------------------------------- storage
# The gate PC's own database: one file, no server to install, backup = copy it.
# Must stay a SQLite *file*: SQLite is refused in every other mode on purpose.
DATABASE_URL=sqlite:///C:/ProgramData/VisionAI/data/gate.db

# 32+ random characters. `VisionAI.exe --setup` generates one.
JWT_SECRET=replace-me-with-48-random-characters
JWT_TTL_MINUTES=15
COOKIE_SECURE=false
RATELIMIT_ENABLED=true

# ------------------------------------------------------------------- auth
# The gate PC is a single machine behind localhost: the operator signs in with
# the account --setup created. Firebase is optional on this deployment.
LEGACY_PASSWORD_LOGIN_ENABLED=true
FIREBASE_AUTH_ENABLED=false
DEMO_MODE=false

# --------------------------------------------------------------- detector
# 1280 px is where the sticker stage was validated on full gate frames.
# Compute cost is quadratic: 640 doubles the speed and halves the reach.
VISION_IMAGE_SIZE=1280
VISION_CONFIDENCE=0.25
OCR_CONFIDENCE_THRESHOLD=0.55
# Set to 0 to switch a stage off for this host.
VISION_STAGE_STICKER=1
VISION_STAGE_PLATE=1
VISION_STAGE_VEHICLE=1

# ------------------------------------------------------------------ camera
# One of:
#   http://user:pass@192.168.1.64/ISAPI/Streaming/channels/101/picture
#       Hikvision. Axis is /axis-cgi/jpg/image.cgi. Dahua: /cgi-bin/snapshot.cgi
#   rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
#   usb:0            (a UVC webcam on this PC)
#   (blank)          use the browser camera from the panel instead
CAMERA_SOURCE=
CAMERA_TIMEOUT=8
# Frames sampled from an RTSP/USB source; the sharpest is kept.
CAMERA_FRAMES=8

# ------------------------------------------------------------------- cloud
# Stage 2 (sync to the cloud portal) is not built yet. Setting this now only
# lets the preflight check the clock against the server.
API_URL=https://srm-trp-transport.onrender.com
